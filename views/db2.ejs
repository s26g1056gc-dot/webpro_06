<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <title>京葉線の駅一覧</title>
</head>
<body>
    <h1>京葉線の駅一覧</h1>
    <table>
        <thead><tr><th>ID</th><th>駅コード</th><th>駅名</th></tr></thead>
        <tbody>
        <% for (const row of data) { %>
            <tr><td><%= row.id %></td><td><%= row.code %></td><td><%= row.name %></td></tr>
        <% } %>
        </tbody>
    </table>
    <p><a href="/public/keiyo_add.html">駅を追加する</a></p>
</body>
</html>
