<!DOCTYPE html>
<html lang="ja">
<head>
    <meta charset="UTF-8">
    <title>京葉線の駅一覧</title>
</head>
<body>
    <h2>京葉線の駅一覧</h2>
    <form action="/keiyo2" method="get">
        <label for="keyword">駅名で検索</label>
        <input type="text" name="keyword" id="keyword" value="<%= keyword %>">
        <button type="submit">検索</button>
        <a href="/keiyo2">すべて表示</a>
    </form>
    <table>
        <thead><tr><th>ID</th><th>駅コード</th><th>駅名</th></tr></thead>
        <tbody>
        <% let count = 0; %>
        <% for (let number = 0; number < data.length; number++) { %>
            <% const row = data[number]; %>
            <% if (row.name.includes(keyword)) { %>
            <tr>
                <td><%= row.id %></td>
                <td><%= row.code %></td>
                <td><a href="/keiyo2/<%= number %>"><%= row.name %></a></td>
            </tr>
                <% count += 1; %>
            <% } %>
        <% } %>
        </tbody>
    </table>
    <p><%= count %>件の駅が見つかりました。</p>
    <p><a href="/public/keiyo2_add.html">駅を追加する</a></p>
</body>
</html>
